      "expect_dry_run": {
        "tile_names_in_paint_order": ["CHECK-IN", "PEOPLE", "VIMS", "FIRM", "LESSON", "GRANT", "PROG"],
        "tile_count": 7
      },
      "expect_commit": {
        "first_tile_text": "CHECK-IN",
        "first_tile_href": "https://checkin.bgcharlem.org"
      }
    },
    {
      "id": "tailwind_gap_changes_layout_not_a_fixed_template",
      "mutate": {
        "path": "apps/hub/src/components/AppDirectory.jsx",
        "replace_once": {
          "from": "grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3",
          "to": "grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3"
        }
      },
      "expect_dry_run": {
        "layout": {
          "columns": 3,
          "gap_px": 32,
          "tile_count": 7
        },
        "assert_vs_baseline": {
          "gap_px_delta": 16,
          "second_column_x_increases": true,
          "second_row_y_increases": true
        }
      },
      "expect_commit": {
        "all_tiles_editable": true
      }
    },
    {
      "id": "unknown_syntax_is_reported_before_mutation",
      "mutate": {
        "path": "apps/hub/src/components/AppDirectory.jsx",
        "replace_once": {
          "from": "<section aria-label=\"Your apps\" className=\"space-y-6\">",
          "to": "<section aria-label=\"Your apps\" className={buildDirectoryClass()} >"
        }
      },
      "expect_dry_run": {
        "error_code": "JSX_UNSUPPORTED_EXPRESSION",
        "diagnostic_source_path_suffix": "apps/hub/src/components/AppDirectory.jsx",
        "diagnostic_span_non_empty": true
      },
      "expect_commit": {
        "rejected": true,
        "document_state_equals_before": true,
        "history_state_equals_before": true
      }
    }
