  "cases": [
    {
      "id": "catalog_name_description_are_not_hard_coded",
      "mutate": {
        "path": "packages/waffle/src/suiteApps.js",
        "replace_once": {
          "from": "name: 'PEOPLE',",
          "to": "name: 'PEOPLE QA',"
        },
        "replace_once_2": {
          "from": "description: 'HR & Operations',",
          "to": "description: 'HR & Operations (fixture)',"
        }
      },
      "expect_dry_run": {
        "contains_text": ["PEOPLE QA", "HR & Operations (fixture)"],
        "exact_text_absent": ["PEOPLE"],
        "tile_count": 7
      },
      "expect_commit": {
        "editable_text_contains": ["PEOPLE QA", "HR & Operations (fixture)"],
        "exactly_one_undo_removes_import": true
      }
    },
    {
      "id": "catalog_order_drives_visual_order",
      "mutate": {
        "path": "packages/waffle/src/suiteApps.js",
        "operation": "move_object_with_id",
        "id": "checkin",
        "to_index": 0
